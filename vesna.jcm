// Four agents. Every one runs the original vesna.VesnaAgent; what separates Alice
// from the others is configuration alone -- use_masks is on for her, so a
// MaskLearner is attached. There is no "primary" agent in the code.
//
// Personalities are in [0,1] and plan annotations in [-1,1], the two ranges the
// original Temper validates. Nothing about the temper mechanism is widened. What
// is new is only that the signed half of the annotation range is used at all: the
// upstream demo runs most_similar with all-positive annotations, so the
// dot-product path was never exercised there.

mas vesna {

    // Alice -- warm, a little disorganised, calm. Every mask starts at zero, so on
    // episode 0 she is simply herself everywhere. strategy random because
    // most_similar is deterministic and there would be nothing to learn.
    // mask_delta bounds how far one mask may shift a trait.
    agent alice: alice.asl {
        ag-class:            vesna.VesnaAgent
        temper:              temper(o(0.55), c(0.35), e(0.50), a(0.75), n(0.30), stress(0.0)[mood], satisfaction(0.0)[mood], social_energy(0.0)[mood])
        strategy:            random
        use_masks:           true
        mask_delta:          0.5
        mask_learning_rate:  0.08
        beliefs:             circumstances([work, home, conference]),
                             rounds_per_partner(3),
                             max_episodes(120),
                             dialogue_episodes(2),
                             verbose
        goals:               start
    }

    // Bob, Carol, Dave -- they do not learn and wear no mask. They are the social
    // environment that pushes back, and they push back differently.

    agent bob: bob.asl {
        ag-class:  vesna.VesnaAgent
        temper:    temper(o(0.30), c(0.85), e(0.25), a(0.30), n(0.40))
        strategy:  random
    }

    agent carol: carol.asl {
        ag-class:  vesna.VesnaAgent
        temper:    temper(o(0.55), c(0.45), e(0.75), a(0.85), n(0.25))
        strategy:  random
    }

    agent dave: dave.asl {
        ag-class:  vesna.VesnaAgent
        temper:    temper(o(0.85), c(0.25), e(0.80), a(0.55), n(0.35))
        strategy:  random
    }

}
