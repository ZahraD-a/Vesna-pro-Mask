// Four agents, all running the same class. The only thing that makes Alice
// different is this file, where masks are switched on for her alone.
//
// Personalities use five traits from 0 to 1; plan annotations in the .asl files run
// from -1 to 1. Both are ranges the original code already accepts. What is new is
// only that the negative half of the plan range is used at all.
//
// Experiment settings are under beliefs: below, so changing an experiment means
// editing this file rather than the agent.

mas vesna {

    // Warm, a little disorganised, calm. Every mask starts at zero, so any difference
    // between circumstances was learned. strategy must be random: the alternative is
    // deterministic and would leave nothing to learn. mask_delta caps how far one
    // mask may shift a trait.
    agent alice: alice.asl {
        ag-class:            vesna.VesnaAgent
        temper:              temper(o(0.55), c(0.35), e(0.50), a(0.75), n(0.30), stress(0.0)[mood], satisfaction(0.0)[mood], social_energy(0.0)[mood])
        strategy:            random
        use_masks:           true
        mask_delta:          0.5
        mask_learning_rate:  0.08
        beliefs:             circumstances([work, home, conference]),
                             rounds_per_partner(3),
                             max_episodes(120),
                             dialogue_episodes(2),
                             verbose
        goals:               start
    }

    // Bob, Carol and Dave do not learn and wear no mask. They react differently from
    // one another, which is what Alice has to work out.

    agent bob: bob.asl {
        ag-class:  vesna.VesnaAgent
        temper:    temper(o(0.30), c(0.85), e(0.25), a(0.30), n(0.40))
        strategy:  random
    }

    agent carol: carol.asl {
        ag-class:  vesna.VesnaAgent
        temper:    temper(o(0.55), c(0.45), e(0.75), a(0.85), n(0.25))
        strategy:  random
    }

    agent dave: dave.asl {
        ag-class:  vesna.VesnaAgent
        temper:    temper(o(0.85), c(0.25), e(0.80), a(0.55), n(0.35))
        strategy:  random
    }

}
