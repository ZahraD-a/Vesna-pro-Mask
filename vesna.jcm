// Four agents. They all run the same agent class; the only thing that makes Alice
// different is this file, where masks are switched on for her and nobody else.
//
// A personality is written with five traits from 0 to 1. Plan annotations, in the
// .asl files, run from -1 to 1. Both are the ranges the original code already
// accepts, and neither has been widened. The only new thing is that the negative
// half of the plan range is actually used here.
//
// Settings for the experiment -- how many episodes, how many rounds, which
// circumstances, whether to print -- are listed under beliefs: below, so a
// different experiment means editing this file and never the agent.

mas vesna {

    // Alice is warm, a little disorganised and calm. All her masks start at zero, so
    // in the first episode she behaves the same everywhere; any difference later was
    // learned. strategy is random because the other option always picks the same plan,
    // and then there would be nothing to learn. mask_delta is how far one mask is
    // allowed to shift a single trait.
    agent alice: alice.asl {
        ag-class:            vesna.VesnaAgent
        temper:              temper(o(0.55), c(0.35), e(0.50), a(0.75), n(0.30), stress(0.0)[mood], satisfaction(0.0)[mood], social_energy(0.0)[mood])
        strategy:            random
        use_masks:           true
        mask_delta:          0.5
        mask_learning_rate:  0.08
        beliefs:             circumstances([work, home, conference]),
                             rounds_per_partner(3),
                             max_episodes(120),
                             dialogue_episodes(2),
                             verbose
        goals:               start
    }

    // Bob, Carol and Dave do not learn and wear no mask. They are the people Alice has
    // to deal with, and they react differently from one another.

    agent bob: bob.asl {
        ag-class:  vesna.VesnaAgent
        temper:    temper(o(0.30), c(0.85), e(0.25), a(0.30), n(0.40))
        strategy:  random
    }

    agent carol: carol.asl {
        ag-class:  vesna.VesnaAgent
        temper:    temper(o(0.55), c(0.45), e(0.75), a(0.85), n(0.25))
        strategy:  random
    }

    agent dave: dave.asl {
        ag-class:  vesna.VesnaAgent
        temper:    temper(o(0.85), c(0.25), e(0.80), a(0.55), n(0.35))
        strategy:  random
    }

}
