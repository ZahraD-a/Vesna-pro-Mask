// Four agents, all running the same class. The only thing that makes Alice
// different is this file, where masks are switched on for her alone.
//
// Personalities and plan annotations in the .asl files both use five traits from -1
// to 1, where 0 is neutral and -1 is the opposite of a trait.
//
// Experiment settings are under beliefs: below, so changing an experiment means
// editing this file rather than the agent.

mas vesna {

    // compat picks the compatibility measure: dot, l1 or cosine. dot is the default and is what
    // the committed results were measured under; the other two exist for the sensitivity study.
    //
    // Warm, a little disorganised, calm. Every mask starts at zero, so any difference
    // between circumstances was learned. strategy must be random: the alternative is
    // deterministic and would leave nothing to learn. mask_delta caps how far one
    // mask may shift a trait.
    agent alice: alice.asl {
        ag-class:            vesna.VesnaAgent
        temper:              temper(o(0.40), c(-0.35), e(0.25), a(0.75), n(-0.60), stress(0.0)[mood], satisfaction(0.0)[mood], social_energy(0.0)[mood])
        strategy:            random
        seed:                1
        compat:              dot
        use_masks:           true
        mask_delta:          0.5
        mask_learning_rate:  0.005
        regret_weighting:    policy
        beliefs:             situations([[at(office),hour(10),colleagues_present], [at(home),hour(20)], [at(venue),hour(14),session_running]]),
                             rounds_per_partner(3),
                             max_episodes(120),
                             dialogue_episodes(2),
                             close_delay(90000),
                             verbose
        goals:               start
    }

    // Bob, Carol and Dave do not learn and wear no mask. They react differently from
    // one another, which is what Alice has to work out.

    agent bob: bob.asl {
        ag-class:  vesna.VesnaAgent
        temper:    temper(o(-0.40), c(0.70), e(-0.50), a(-0.40), n(-0.20))
        strategy:  random
        seed:      1
        compat:    dot
    }

    agent carol: carol.asl {
        ag-class:  vesna.VesnaAgent
        temper:    temper(o(0.10), c(-0.10), e(0.50), a(0.70), n(-0.50))
        strategy:  random
        seed:      1
        compat:    dot
    }

    agent dave: dave.asl {
        ag-class:  vesna.VesnaAgent
        temper:    temper(o(0.70), c(-0.50), e(0.60), a(0.10), n(-0.30))
        strategy:  random
        seed:      1
        compat:    dot
    }

}
